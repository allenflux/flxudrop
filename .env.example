# Copy to .env. Cold storage remains disabled until explicitly enabled.
FLUXDROP_COLD_STORAGE_ENABLED=0
FLUXDROP_S3_BUCKET=your-private-bucket
FLUXDROP_S3_REGION=ap-northeast-3
FLUXDROP_S3_ENDPOINT=https://s3.ap-northeast-3.amazonaws.com
FLUXDROP_S3_PREFIX=fluxdrop-cold/

# Docker mounts this directory read-only. Native Python uses KEY_FILE directly.
FLUXDROP_SECRETS_DIR=./secrets
FLUXDROP_ENCRYPTION_KEY_FILE=./secrets/keys.json
# Empty uses the keyring's active ID.
FLUXDROP_ENCRYPTION_KEY_ID=

# Prefer an IAM role or a shared credentials file over embedding credentials.
# Docker reads ./secrets/aws-credentials via the standard Boto3 provider chain.
# Native Python can set AWS_SHARED_CREDENTIALS_FILE=./secrets/aws-credentials.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

FLUXDROP_COLD_IDLE_DAYS=7
FLUXDROP_COLD_BLOCK_MB=32
FLUXDROP_COLD_MAX_OBJECT_MB=100
FLUXDROP_COLD_DISK_RESERVE_MB=512
FLUXDROP_COLD_WAIT_SECONDS=15
FLUXDROP_COLD_SCAN_SECONDS=300
FLUXDROP_COLD_RETRY_BASE_SECONDS=2
FLUXDROP_COLD_RETRY_MAX_SECONDS=300
FLUXDROP_S3_CONNECT_TIMEOUT=5
FLUXDROP_S3_READ_TIMEOUT=30
